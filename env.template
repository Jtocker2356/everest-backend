# ============================================================================
# EVEREST TRADING PLATFORM - ENVIRONMENT VARIABLES
# Copy this to .env and fill in your actual values
# ============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database
DB_USER=postgres
DB_HOST=localhost
DB_NAME=everest_trading
DB_PASSWORD=your_database_password_here
DB_PORT=5432

# Firebase Admin SDK
# Get these from Firebase Console → Project Settings → Service Accounts
# Click "Generate New Private Key" and extract values from the JSON
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Alpaca API (Live Trading)
ALPACA_API_KEY=AKUA7B4NELU3P6TRSMUGIZZ2YQ
ALPACA_SECRET_KEY=DvvHXgKzLZyzQnuRr3vLcJEdRsob6u6mHxSixdrXYLvE

# Polygon.io API (Real-time Prices)
POLYGON_API_KEY=SJhwVDkYdqKqih0XHWMsifOjpO2hPY5r

# Plaid API (Bank Connections)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox

# Security
JWT_SECRET=your_random_secret_key_here_change_this_in_production

# Partner Bank API (for cash sweep)
